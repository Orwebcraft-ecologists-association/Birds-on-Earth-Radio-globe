# Google Gemini API Key for tree identification
# Get your API key from https://ai.google.dev/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom BirdNET API endpoint
# If you have a backend service aggregating BirdNET data
# VITE_BIRDNET_API_URL=https://your-backend-api.com/birdnet

# Optional: Radio Browser API endpoint override
# By default uses https://de1.api.radio-browser.info/json
# VITE_RADIO_BROWSER_API=https://de1.api.radio-browser.info/json
